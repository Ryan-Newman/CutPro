<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CutPro</RootNamespace>
    <AssemblyName>CutPro</AssemblyName>
    <AssemblyTitle>VEdiT</AssemblyTitle>
    <Title>VEdiT</Title>
    <Product>VEdiT</Product>
    <ApplicationIcon>Assets/CutPro.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <Resource Include="Assets/CutPro.ico" />
  </ItemGroup>
</Project>
